{
  "name": "@afilmory/webgl-viewer",
  "type": "module",
  "version": "0.2.0",
  "description": "High-performance WebGL image viewer for React with tiled LOD rendering, pinch/wheel/double-tap gestures, and worker-based texture decoding",
  "author": "Innei",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vsxd/afilmory-vercel",
    "directory": "packages/webgl-viewer"
  },
  "keywords": [
    "webgl",
    "image-viewer",
    "react",
    "zoom",
    "pan",
    "tiles",
    "lod",
    "photo"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "test": "pnpm --dir ../.. exec vitest run --project webgl-viewer",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "nbump": "2.1.8",
    "react": "19.2.0",
    "tsdown": "0.15.12",
    "unplugin-dts": "1.0.0-beta.6",
    "vite": "7.1.12"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
